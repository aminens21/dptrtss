rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    function isAdmin() {
      return request.auth != null && (
        request.auth.token.email == 'printomrdesigne@gmail.com' ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'CENTRAL_ADMIN')
      );
    }
    
    function isSportManager() {
      return request.auth != null && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'SPORT_MANAGER';
    }
    
    function isManagerForSport(sportId) {
      return isSportManager() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.sportId == sportId;
    }

    function isTechCommitteeHead() {
      return request.auth != null && 
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isTechCommitteeHead == true;
    }
    
    function isAuthenticated() {
      return request.auth != null;
    }

    match /users/{userId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if isAdmin();
    }

    match /sports/{document=**} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /tournaments/{document} {
      allow read: if true;
      allow create: if isAdmin() || isTechCommitteeHead() || isManagerForSport(request.resource.data.sportId);
      allow update: if isAdmin() || isTechCommitteeHead() || isManagerForSport(resource.data.sportId);
      allow delete: if isAdmin() || isTechCommitteeHead();
    }

    match /schools/{document=**} {
      allow read: if true;
      allow create, update: if isAdmin() || isSportManager() || isTechCommitteeHead();
      allow delete: if isAdmin();
    }

    match /teams/{document} {
      allow read: if true;
      allow create: if isAdmin() || isTechCommitteeHead() || isManagerForSport(request.resource.data.sportId);
      allow update: if isAdmin() || isTechCommitteeHead() || isManagerForSport(resource.data.sportId);
      allow delete: if isAdmin() || isTechCommitteeHead();
    }

    match /matches/{document} {
      allow read: if true;
      allow create: if isAdmin() || isTechCommitteeHead() || isManagerForSport(request.resource.data.sportId);
      allow update: if isAdmin() || isTechCommitteeHead() || isManagerForSport(resource.data.sportId);
      allow delete: if isAdmin() || isTechCommitteeHead();
    }

    match /venues/{document=**} {
      allow read: if true;
      allow write: if isAdmin() || isTechCommitteeHead() || isSportManager();
    }

    match /announcements/{document=**} {
      allow read: if true;
      allow create, update: if isAdmin() || isSportManager() || isTechCommitteeHead();
      allow delete: if isAdmin() || isTechCommitteeHead();
    }

    match /referees/{document} {
      allow read: if true;
      allow create, update, delete: if isAdmin() || isTechCommitteeHead();
    }

    match /students/{document} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAuthenticated();
    }

    match /notifications/{document} {
      allow read, create, update: if isAuthenticated();
      allow delete: if isAdmin() || isTechCommitteeHead();
    }
  }
}
